# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)
# These are merged on top of defaults; static asset MIME types are handled automatically.

/*
  # Strict security baseline. WASM via cross-origin isolation so we can use
  # SharedArrayBuffer if needed for future high-perf encoders.
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Long-cache hashed assets emitted by Vite (file names include hashes).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Index pages: short cache so deploys roll out fast; allow stale-while-revalidate.
/index.html
  Cache-Control: public, max-age=300, must-revalidate
/zh-CN/index.html
  Cache-Control: public, max-age=300, must-revalidate

# Service worker manifest and web manifest.
/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# SVG / favicons: cache longer than HTML but not as long as hashed assets.
/icon.svg
  Cache-Control: public, max-age=86400
/favicon-*.png
  Cache-Control: public, max-age=86400
/icon-*.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Allow Cloudflare's image resizer to opt-in to AVIF/WEBP negotiation.
# (`vary: Accept` lets the CDN serve a different body per `Accept` header.)
/*
  Vary: Accept
  Vary: Accept-Encoding